{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "outDir": "./dist/out-tsc/spec",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "isolatedModules": true,
        "types": [
            "jest",
            "node"
        ],
        "esModuleInterop": true
    },
    "files": [
        "jest/test.ts"
    ],
    "include": [
        "apps/**/*.spec.ts",
        "apps/**/*.mock.ts",
        "libs/**/*.spec.ts",
        "libs/**/*.mock.ts",
        "**/*.d.ts"
    ]
}