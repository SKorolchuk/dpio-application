{
    "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
    "version": 1,
    "newProjectRoot": "",
    "projects": {
        "dpio-application": {
            "root": "apps/dpio-application",
            "sourceRoot": "apps/dpio-application/src",
            "projectType": "application",
            "prefix": "app",

            "i18n": {
                "sourceLocale": "en-US",
                "locales": {
                    "de": "apps/dpio-application/src/i18n/messages.de.xlf"
                }
            },
            "schematics": {
                "@schematics/angular:component": {
                    "style": "scss",
                    "standalone": true,
                    "changeDetection": "OnPush"
                }
            },
            "architect": {
                "build": {
                    "builder": "@angular/build:application",
                    "options": {
                        "outputPath": {
                            "base": "dist/apps/dpio-application"
                        },
                        "index": "apps/dpio-application/src/index.html",
                        "browser": "apps/dpio-application/src/main.ts",
                        "tsConfig": "apps/dpio-application/tsconfig.app.json",
                        "inlineStyleLanguage": "scss",
                        "assets": [
                            "apps/dpio-application/src/favicon.ico",
                            "apps/dpio-application/src/assets",
                            "apps/dpio-application/src/manifest.json"
                        ],
                        "styles": [
                            "node_modules/@angular/material/prebuilt-themes/indigo-pink.css",
                            "apps/dpio-application/src/styles.scss"
                        ],
                        "stylePreprocessorOptions": {
                            "includePaths": ["apps/dpio-application/src/theme"]
                        },
                        "polyfills": ["@angular/localize/init"]
                    },
                    "configurations": {
                        "production": {
                            "fileReplacements": [
                                {
                                    "replace": "apps/dpio-application/src/environments/environment.ts",
                                    "with": "apps/dpio-application/src/environments/environment.prod.ts"
                                }
                            ],
                            "localize": true,
                            "optimization": true,
                            "outputHashing": "all",
                            "sourceMap": false,
                            "extractLicenses": true,
                            "define": {
                                "import.meta.env.NG_BUILD_PRODUCTION": "true"
                            }
                        },
                        "development": {
                            "optimization": false,
                            "extractLicenses": false,
                            "sourceMap": true,
                            "define": {
                                "import.meta.env.NG_BUILD_PRODUCTION": "false"
                            }
                        }
                    },
                    "defaultConfiguration": "production"
                },
                "serve": {
                    "builder": "@angular/build:dev-server",
                    "options": {
                        "proxyConfig": "proxy.conf.cjs"
                    },
                    "configurations": {
                        "production": {
                            "buildTarget": "dpio-application:build:production"
                        },
                        "development": {
                            "buildTarget": "dpio-application:build:development"
                        }
                    },
                    "defaultConfiguration": "development"
                },
                "extract-i18n": {
                    "builder": "@angular/build:extract-i18n",
                    "options": {
                        "buildTarget": "dpio-application:build",
                        "outputPath": "apps/dpio-application/src/i18n",
                        "outFile": "messages.xlf"
                    }
                }
            }
        },
        "shared": {
            "root": "libs/shared",
            "sourceRoot": "libs/shared/src",
            "projectType": "library",
            "prefix": "dpio-application"
        },
        "core": {
            "root": "libs/core",
            "sourceRoot": "libs/core/src",
            "projectType": "library",
            "prefix": "dpio-application"
        },
        "auth": {
            "root": "libs/auth",
            "sourceRoot": "libs/auth/src",
            "projectType": "library",
            "prefix": "dpio-application"
        }
    },
    "cli": {
        "analytics": false
    }
}
