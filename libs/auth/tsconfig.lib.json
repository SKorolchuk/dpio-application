{
    "extends": "../../tsconfig.json",
    "compilerOptions": {
        "outDir": "../../dist/out-tsc/libs/auth",
        // Aligns declaration output to generate native types files metadata
        "declaration": true,
        "declarationMap": true,
        "types": []
    },
    "angularCompilerOptions": {
        // Enable modern compilation architecture for internal standalone libraries
        "strictInjectionParameters": true,
        "strictTemplates": true
    },
    "include": ["src/**/*.ts"],
    "exclude": ["src/**/*.spec.ts", "src/**/*.mock.ts"]
}
