{
    "extends": "../../tsconfig.json",
    "compilerOptions": {
        "outDir": "../../dist/out-tsc/libs/shared",
        "declaration": true,
        "declarationMap": true,
        "types": []
    },
    "angularCompilerOptions": {
        "strictInjectionParameters": true,
        "strictTemplates": true
    },
    "include": ["src/**/*.ts"],
    "exclude": ["src/**/*.spec.ts", "src/**/*.mock.ts"]
}
