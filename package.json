{
    "name": "dpio-application",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "ng": "ng",
        "i18n": "ng extract-i18n",
        "start": "ng serve",
        "build": "ng build --configuration production",
        "watch": "ng build --watch --configuration development",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:ci": "jest --ci --coverage --reporters=default --reporters=jest-junit",
        "lint": "eslint .",
        "format": "prettier --write \"{apps,libs,e2e,jest}/**/*.{ts,html,scss,json,md}\" && eslint . --fix",
        "e2e": "playwright test",
        "e2e:ui": "playwright test --ui"
    },
    "engines": {
        "node": "^24.21.0"
    },
    "dependencies": {
        "@angular/cdk": "^22.2.2",
        "@angular/common": "^22.2.2",
        "@angular/compiler": "^22.2.2",
        "@angular/core": "^22.2.2",
        "@angular/forms": "^22.2.2",
        "@angular/localize": "^22.2.2",
        "@angular/material": "^22.2.2",
        "@angular/platform-browser": "^22.2.2",
        "@angular/router": "^22.2.2",
        "@angular/service-worker": "^22.2.2",
        "@ngrx/effects": "^22.0.1",
        "@ngrx/router-store": "^22.0.1",
        "@ngrx/store": "^22.0.1",
        "@ngrx/store-devtools": "^22.0.1",
        "@ngrx/signals": "^22.0.1",
        "jwt-decode": "^4.0.0",
        "rxjs": "^7.8.2",
        "tslib": "^2.8.1"
    },
    "devDependencies": {
        "@angular/build": "^22.2.2",
        "@angular/cli": "^22.2.5",
        "@angular/compiler-cli": "^22.2.2",
        "@angular-eslint/builder": "^22.5.0",
        "@angular-eslint/eslint-plugin": "^22.5.0",
        "@angular-eslint/eslint-plugin-template": "^22.5.0",
        "@angular-eslint/template-parser": "^22.5.0",
        "@ngrx/schematics": "^22.0.1",
        "@playwright/test": "^1.64.0",
        "@types/jest": "^30.0.0",
        "@types/node": "^24.19.1",
        "eslint": "^10.12.0",
        "@eslint/js": "^10.0.1",
        "angular-eslint": "^22.5.0",
        "eslint-config-prettier": "^10.1.8",
        "jest": "^30.5.2",
        "jest-environment-jsdom": "^30.5.2",
        "jest-junit": "^17.0.0",
        "jest-preset-angular": "^17.0.2",
        "lint-staged": "^17.6.0",
        "prettier": "^3.9.9",
        "typescript": "~6.0.3"
    },
    "lint-staged": {
        "*.{ts,html,scss,json,md}": "prettier --write",
        "*.{ts,html}": "eslint --fix"
    },
    "browserslist": [
        "> 1%",
        "last 2 versions"
    ]
}
